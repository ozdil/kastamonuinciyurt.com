/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), payment=(), geolocation=()
  Link: </.well-known/api-catalog>; rel="api-catalog", </.well-known/ai-catalog.json>; rel="service-desc", </llms.txt>; rel="describedby", </llms.txt>; rel="alternate"; type="text/markdown", </assets/data/yurt-info.json>; rel="alternate"; type="application/json"

/index.html
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  Vary: Accept

/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=86400
  Vary: Accept

/locator-plus.html
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=86400

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/assets/data/yurt-info.json
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/scripts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/favicon.png
  Cache-Control: public, max-age=31536000, immutable

/assets/logo.png
  Cache-Control: public, max-age=31536000, immutable
